<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>io.github.louaychayeb.flowforge</groupId>
    <artifactId>flowforge-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>FlowForge</name>
    <description>A durable, fault-tolerant workflow execution engine built on Spring Boot, PostgreSQL and Kafka.</description>
    <url>https://github.com/LouayChayeb/flowforge</url>

    <modules>
        <module>flowforge-common</module>
        <module>flowforge-orchestrator</module>
        <module>flowforge-worker</module>
        <module>flowforge-payments</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 1.21.4 works with Docker Engine 29; the version Spring Boot 3.5.6 manages does not. -->
        <testcontainers.version>1.21.4</testcontainers.version>
    </properties>

    <profiles>
        <!--
            On some Windows machines the JDK cannot create the Unix domain socket it uses internally for
            NIO selectors in the user's temp folder ("Unable to establish loopback connection"), which breaks
            Tomcat and the Kafka client. Pointing it at the system temp folder avoids that.
        -->
        <profile>
            <id>windows-nio-tmpdir</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <nio.tmpdir.arg>-Djdk.net.unixdomain.tmpdir=${env.SystemRoot}\Temp</nio.tmpdir.arg>
                <argLine>${nio.tmpdir.arg}</argLine>
                <spring-boot.run.jvmArguments>${nio.tmpdir.arg}</spring-boot.run.jvmArguments>
            </properties>
        </profile>
    </profiles>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.louaychayeb.flowforge</groupId>
                <artifactId>flowforge-common</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
